{
  "info": {
    "name": "Activity 7 - Campus Maintenance Requests API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import into Postman. Set the baseUrl variable (collection Variables tab) to http://localhost:3000 or your hosted URL, then run the collection in order."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "recordId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. GET / (API guide)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET /health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Database connected\", function () { pm.expect(pm.response.json().database).to.eql(\"connected\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET all records",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/records",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "records"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Body is an array\", function () { pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "4. POST valid record (saves recordId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/records",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "records"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Broken classroom light\",\n  \"category\": \"Electrical\",\n  \"description\": \"The light in Room B12 does not switch on.\",\n  \"status\": \"Pending\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test(\"Has a new id\", function () { pm.expect(body.id).to.be.a(\"number\"); });",
              "pm.collectionVariables.set(\"recordId\", body.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "5. GET the record just created",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/records/{{recordId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "records",
            "{{recordId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Same record\", function () { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"recordId\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "6. PUT update the same id",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/records/{{recordId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "records",
            "{{recordId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Broken classroom light\",\n  \"category\": \"Electrical\",\n  \"description\": \"The light in Room B12 was replaced.\",\n  \"status\": \"Completed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Changed values, same id\", function () { const b = pm.response.json(); pm.expect(b.status).to.eql(\"Completed\"); pm.expect(b.id).to.eql(Number(pm.collectionVariables.get(\"recordId\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "7. DELETE the same id",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/records/{{recordId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "records",
            "{{recordId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Deletion message\", function () { pm.expect(pm.response.json().message).to.eql(\"Record deleted.\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "8. GET deleted id -> 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
