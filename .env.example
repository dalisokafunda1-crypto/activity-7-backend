# Copy this file to .env and fill in your own values. Never commit .env to Git.

# PostgreSQL connection string (local database, Render, Neon, ...)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/maintenance

# Browser origins allowed to call the API, separated by commas (needed for Activity 8).
# Add your hosted frontend address here once you have it, for example https://your-frontend.netlify.app
CLIENT_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Shown on the API guide page (GET /)
STUDENT_NUMBER=YOUR-STUDENT-NUMBER

# Optional
# PORT=3000
# DATABASE_SSL=false      # set true/false only if your host needs it
# PUBLIC_URL=https://your-backend.onrender.com
